{
  "name": "shelfy",
  "displayName": "Shelfy",
  "description": "Save project directories globally and organize them in virtual folders.",
  "version": "0.0.39",
  "publisher": "TheBabonz",
  "repository": {
    "type": "git",
    "url": "https://github.com/thebabonz/shelfy.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "icon": "media/icon-256.png",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "globalProjects",
          "title": "Shelfy",
          "icon": "media/activitybar/icon.svg"
        }
      ]
    },
    "views": {
      "globalProjects": [
        {
          "id": "globalProjectsView",
          "name": "Shelfy",
          "icon": "media/activitybar/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "globalProjects.addProject",
        "title": "Add Project",
        "icon": {
          "light": "media/light/add-project.svg",
          "dark": "media/dark/add-project.svg"
        }
      },
      {
        "command": "globalProjects.addRootGroup",
        "title": "Add Folder",
        "icon": {
          "light": "media/light/add-folder.svg",
          "dark": "media/dark/add-folder.svg"
        }
      },
      {
        "command": "globalProjects.addSubgroup",
        "title": "Add Subfolder",
        "icon": {
          "light": "media/light/add-folder.svg",
          "dark": "media/dark/add-folder.svg"
        }
      },
      {
        "command": "globalProjects.renameGroup",
        "title": "Rename Folder",
        "icon": {
          "light": "media/light/edit.svg",
          "dark": "media/dark/edit.svg"
        }
      },
      {
        "command": "globalProjects.renameProject",
        "title": "Rename Project",
        "icon": {
          "light": "media/light/edit.svg",
          "dark": "media/dark/edit.svg"
        }
      },
      {
        "command": "globalProjects.addProjectScript",
        "title": "Add Script",
        "icon": {
          "light": "media/light/add-script.svg",
          "dark": "media/dark/add-script.svg"
        }
      },
      {
        "command": "globalProjects.runProjectScript",
        "title": "Run Script",
        "icon": {
          "light": "media/light/run-script.svg",
          "dark": "media/dark/run-script.svg"
        }
      },
      {
        "command": "globalProjects.removeProjectScript",
        "title": "Remove Script",
        "icon": {
          "light": "media/light/trash.svg",
          "dark": "media/dark/trash.svg"
        }
      },
      {
        "command": "globalProjects.removeItem",
        "title": "Remove",
        "icon": {
          "light": "media/light/trash.svg",
          "dark": "media/dark/trash.svg"
        }
      },
      {
        "command": "globalProjects.moveItemToFolder",
        "title": "Move to Folder...",
        "icon": "$(move)"
      },
      {
        "command": "globalProjects.openProject",
        "title": "Open Project",
        "icon": {
          "light": "media/light/open-project.svg",
          "dark": "media/dark/open-project.svg"
        }
      },
      {
        "command": "globalProjects.openProjectInNewWindow",
        "title": "Open in New Window",
        "icon": {
          "light": "media/light/open-project-new-window.svg",
          "dark": "media/dark/open-project-new-window.svg"
        }
      },
      {
        "command": "globalProjects.openInExplorer",
        "title": "Open in Explorer",
        "icon": {
          "light": "media/light/open-explorer.svg",
          "dark": "media/dark/open-explorer.svg"
        }
      },
      {
        "command": "globalProjects.openProjectFromRow",
        "title": "Open Project (Row Click)"
      },
      {
        "command": "globalProjects.refresh",
        "title": "Refresh",
        "icon": {
          "light": "media/light/refresh.svg",
          "dark": "media/dark/refresh.svg"
        }
      },
      {
        "command": "globalProjects.exportConfiguration",
        "title": "Shelfy: Export Configuration"
      },
      {
        "command": "globalProjects.importConfiguration",
        "title": "Shelfy: Import Configuration"
      },
      {
        "command": "globalProjects.cloneGroupWithNewBase",
        "title": "Clone with New Base Path",
        "icon": "$(copy)"
      },
      {
        "command": "globalProjects.enableEditMode",
        "title": "Enable Edit Mode",
        "icon": "$(edit)"
      },
      {
        "command": "globalProjects.disableEditMode",
        "title": "Disable Edit Mode",
        "icon": "$(lock)"
      },
      {
        "command": "globalProjects.cycleSortFromNone",
        "title": "Sort: None",
        "icon": {
          "light": "media/light/sort-none.svg",
          "dark": "media/dark/sort-none.svg"
        }
      },
      {
        "command": "globalProjects.cycleSortFromAsc",
        "title": "Sort: Ascending",
        "icon": {
          "light": "media/light/sort-asc.svg",
          "dark": "media/dark/sort-asc.svg"
        }
      },
      {
        "command": "globalProjects.cycleSortFromDesc",
        "title": "Sort: Descending",
        "icon": {
          "light": "media/light/sort-desc.svg",
          "dark": "media/dark/sort-desc.svg"
        }
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "globalProjects.enableEditMode",
          "when": "view == globalProjectsView && !globalProjects.editMode",
          "group": "navigation@1"
        },
        {
          "command": "globalProjects.disableEditMode",
          "when": "view == globalProjectsView && globalProjects.editMode",
          "group": "navigation@1"
        },
        {
          "command": "globalProjects.addRootGroup",
          "when": "view == globalProjectsView && globalProjects.editMode",
          "group": "navigation@2"
        },
        {
          "command": "globalProjects.addProject",
          "when": "view == globalProjectsView && globalProjects.editMode",
          "group": "navigation@3"
        },
        {
          "command": "globalProjects.refresh",
          "when": "view == globalProjectsView",
          "group": "navigation@4"
        },
        {
          "command": "globalProjects.cycleSortFromNone",
          "when": "view == globalProjectsView && globalProjects.sortMode == none",
          "group": "navigation@5"
        },
        {
          "command": "globalProjects.cycleSortFromAsc",
          "when": "view == globalProjectsView && globalProjects.sortMode == asc",
          "group": "navigation@5"
        },
        {
          "command": "globalProjects.cycleSortFromDesc",
          "when": "view == globalProjectsView && globalProjects.sortMode == desc",
          "group": "navigation@5"
        }
      ],
      "view/item/context": [
        {
          "command": "globalProjects.openProject",
          "when": "view == globalProjectsView && viewItem == project && !globalProjects.editMode && (globalProjects.clickAction == noAction || globalProjects.clickAction == openNewInstance)",
          "group": "inline@1"
        },
        {
          "command": "globalProjects.openProjectInNewWindow",
          "when": "view == globalProjectsView && viewItem == project && !globalProjects.editMode && (globalProjects.clickAction == noAction || globalProjects.clickAction == openSameInstance)",
          "group": "inline@2"
        },
        {
          "command": "globalProjects.openInExplorer",
          "when": "view == globalProjectsView && viewItem == project && !globalProjects.editMode",
          "group": "inline@3"
        },
        {
          "command": "globalProjects.addProject",
          "when": "view == globalProjectsView && viewItem == group && globalProjects.editMode",
          "group": "inline"
        },
        {
          "command": "globalProjects.addSubgroup",
          "when": "view == globalProjectsView && viewItem == group && globalProjects.editMode",
          "group": "inline"
        },
        {
          "command": "globalProjects.renameGroup",
          "when": "view == globalProjectsView && viewItem == group && globalProjects.editMode",
          "group": "inline"
        },
        {
          "command": "globalProjects.renameProject",
          "when": "view == globalProjectsView && viewItem == project && globalProjects.editMode",
          "group": "inline"
        },
        {
          "command": "globalProjects.addProjectScript",
          "when": "view == globalProjectsView && viewItem == project && globalProjects.editMode",
          "group": "inline"
        },
        {
          "command": "globalProjects.cloneGroupWithNewBase",
          "when": "view == globalProjectsView && viewItem == group && globalProjects.editMode",
          "group": "inline"
        },
        {
          "command": "globalProjects.moveItemToFolder",
          "when": "view == globalProjectsView && (viewItem == group || viewItem == project) && globalProjects.editMode",
          "group": "2_modification@1"
        },
        {
          "command": "globalProjects.runProjectScript",
          "when": "view == globalProjectsView && viewItem == script && !globalProjects.editMode",
          "group": "inline@1"
        },
        {
          "command": "globalProjects.removeProjectScript",
          "when": "view == globalProjectsView && viewItem == script && globalProjects.editMode",
          "group": "inline"
        },
        {
          "command": "globalProjects.removeItem",
          "when": "view == globalProjectsView && (viewItem == group || viewItem == project) && globalProjects.editMode",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "Shelfy",
      "properties": {
        "globalProjects.clickAction": {
          "type": "string",
          "enum": [
            "noAction",
            "openSameInstance",
            "openNewInstance"
          ],
          "default": "openSameInstance",
          "markdownDescription": "Action for click on a project row."
        },
        "globalProjects.showProjectPath": {
          "type": "boolean",
          "default": false,
          "description": "Show the folder path below the project name in the tree view."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test out/test/editModeBehavior.test.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  }
}
