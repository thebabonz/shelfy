{
  "name": "shelfy",
  "displayName": "Shelfy",
  "description": "Save project directories globally and organize them in virtual folders.",
  "version": "0.0.54",
  "publisher": "TheBabonz",
  "repository": {
    "type": "git",
    "url": "https://github.com/thebabonz/shelfy.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "icon": "media/icon-256.png",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "shelfy",
          "title": "Shelfy",
          "icon": "media/activitybar/icon.svg"
        }
      ]
    },
    "views": {
      "shelfy": [
        {
          "id": "shelfyView",
          "name": "Shelfy",
          "icon": "media/activitybar/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "shelfy.addProject",
        "title": "Add Project",
        "icon": {
          "light": "media/light/add-project.svg",
          "dark": "media/dark/add-project.svg"
        }
      },
      {
        "command": "shelfy.addRootGroup",
        "title": "Add Folder",
        "icon": {
          "light": "media/light/add-folder.svg",
          "dark": "media/dark/add-folder.svg"
        }
      },
      {
        "command": "shelfy.addSubgroup",
        "title": "Add Subfolder",
        "icon": {
          "light": "media/light/add-folder.svg",
          "dark": "media/dark/add-folder.svg"
        }
      },
      {
        "command": "shelfy.renameGroup",
        "title": "Rename Folder",
        "icon": {
          "light": "media/light/edit.svg",
          "dark": "media/dark/edit.svg"
        }
      },
      {
        "command": "shelfy.renameProject",
        "title": "Rename Project",
        "icon": {
          "light": "media/light/edit.svg",
          "dark": "media/dark/edit.svg"
        }
      },
      {
        "command": "shelfy.editItemPersonalization",
        "title": "Edit Personalization",
        "icon": "$(paintcan)"
      },
      {
        "command": "shelfy.revertItemPersonalization",
        "title": "Revert Personalization",
        "icon": "$(discard)"
      },
      {
        "command": "shelfy.addProjectScript",
        "title": "Add Script",
        "icon": {
          "light": "media/light/add-script.svg",
          "dark": "media/dark/add-script.svg"
        }
      },
      {
        "command": "shelfy.editProjectScript",
        "title": "Edit Script",
        "icon": {
          "light": "media/light/edit.svg",
          "dark": "media/dark/edit.svg"
        }
      },
      {
        "command": "shelfy.runProjectScript",
        "title": "Run Script",
        "icon": {
          "light": "media/light/run-script.svg",
          "dark": "media/dark/run-script.svg"
        }
      },
      {
        "command": "shelfy.removeProjectScript",
        "title": "Remove Script",
        "icon": {
          "light": "media/light/trash.svg",
          "dark": "media/dark/trash.svg"
        }
      },
      {
        "command": "shelfy.removeItem",
        "title": "Remove",
        "icon": {
          "light": "media/light/trash.svg",
          "dark": "media/dark/trash.svg"
        }
      },
      {
        "command": "shelfy.moveItemToFolder",
        "title": "Move to Folder...",
        "icon": "$(move)"
      },
      {
        "command": "shelfy.openProject",
        "title": "Open Project",
        "icon": {
          "light": "media/light/open-project.svg",
          "dark": "media/dark/open-project.svg"
        }
      },
      {
        "command": "shelfy.openProjectInNewWindow",
        "title": "Open in New Window",
        "icon": {
          "light": "media/light/open-project-new-window.svg",
          "dark": "media/dark/open-project-new-window.svg"
        }
      },
      {
        "command": "shelfy.openInExplorer",
        "title": "Open in Explorer",
        "icon": {
          "light": "media/light/open-explorer.svg",
          "dark": "media/dark/open-explorer.svg"
        }
      },
      {
        "command": "shelfy.openProjectFromRow",
        "title": "Open Project (Row Click)"
      },
      {
        "command": "shelfy.refresh",
        "title": "Refresh",
        "icon": {
          "light": "media/light/refresh.svg",
          "dark": "media/dark/refresh.svg"
        }
      },
      {
        "command": "shelfy.collapseAll",
        "title": "Collapse All",
        "icon": "$(collapse-all)"
      },
      {
        "command": "shelfy.openSettings",
        "title": "Shelfy Settings",
        "icon": "$(settings-gear)"
      },
      {
        "command": "shelfy.setFilter",
        "title": "Filter Projects",
        "icon": "$(search)"
      },
      {
        "command": "shelfy.clearFilter",
        "title": "Clear Filter",
        "icon": {
          "light": "media/light/clear-filter.svg",
          "dark": "media/dark/clear-filter.svg"
        }
      },
      {
        "command": "shelfy.exportConfiguration",
        "title": "Shelfy: Export Configuration"
      },
      {
        "command": "shelfy.importConfiguration",
        "title": "Shelfy: Import Configuration"
      },
      {
        "command": "shelfy.cloneGroupWithNewBase",
        "title": "Clone with New Base Path",
        "icon": "$(copy)"
      },
      {
        "command": "shelfy.enableEditMode",
        "title": "Enable Edit Mode",
        "icon": "$(edit)"
      },
      {
        "command": "shelfy.disableEditMode",
        "title": "Disable Edit Mode",
        "icon": "$(lock)"
      },
      {
        "command": "shelfy.cycleSortFromNone",
        "title": "Sort: None",
        "icon": {
          "light": "media/light/sort-none.svg",
          "dark": "media/dark/sort-none.svg"
        }
      },
      {
        "command": "shelfy.cycleSortFromAsc",
        "title": "Sort: Ascending",
        "icon": {
          "light": "media/light/sort-asc.svg",
          "dark": "media/dark/sort-asc.svg"
        }
      },
      {
        "command": "shelfy.cycleSortFromDesc",
        "title": "Sort: Descending",
        "icon": {
          "light": "media/light/sort-desc.svg",
          "dark": "media/dark/sort-desc.svg"
        }
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "shelfy.setFilter",
          "when": "view == shelfyView",
          "group": "navigation@1"
        },
        {
          "command": "shelfy.clearFilter",
          "when": "view == shelfyView && shelfy.hasFilter",
          "group": "navigation@2"
        },
        {
          "command": "shelfy.cycleSortFromNone",
          "when": "view == shelfyView && shelfy.sortMode == none",
          "group": "navigation@3"
        },
        {
          "command": "shelfy.cycleSortFromAsc",
          "when": "view == shelfyView && shelfy.sortMode == asc",
          "group": "navigation@3"
        },
        {
          "command": "shelfy.cycleSortFromDesc",
          "when": "view == shelfyView && shelfy.sortMode == desc",
          "group": "navigation@3"
        },
        {
          "command": "shelfy.enableEditMode",
          "when": "view == shelfyView && !shelfy.editMode && !shelfy.hasFilter",
          "group": "navigation@4",
          "order": 1
        },
        {
          "command": "shelfy.disableEditMode",
          "when": "view == shelfyView && shelfy.editMode",
          "group": "navigation@6",
          "order": 1
        },
        {
          "command": "shelfy.collapseAll",
          "when": "view == shelfyView",
          "group": "navigation@4",
          "order": 0
        },
        {
          "command": "shelfy.addRootGroup",
          "when": "view == shelfyView && shelfy.editMode",
          "group": "navigation@5"
        },
        {
          "command": "shelfy.addProject",
          "when": "view == shelfyView && shelfy.editMode",
          "group": "navigation@6",
          "order": 0
        },
        {
          "command": "shelfy.refresh",
          "when": "view == shelfyView",
          "group": "navigation@7"
        },
        {
          "command": "shelfy.openSettings",
          "when": "view == shelfyView",
          "group": "navigation@8"
        }
      ],
      "view/item/context": [
        {
          "command": "shelfy.openProject",
          "when": "view == shelfyView && viewItem =~ /^project(?:$|:)/ && !shelfy.editMode && (shelfy.clickAction == noAction || shelfy.clickAction == openNewInstance)",
          "group": "inline@1"
        },
        {
          "command": "shelfy.openProjectInNewWindow",
          "when": "view == shelfyView && viewItem =~ /^project(?:$|:)/ && !shelfy.editMode && (shelfy.clickAction == noAction || shelfy.clickAction == openSameInstance)",
          "group": "inline@2"
        },
        {
          "command": "shelfy.openInExplorer",
          "when": "view == shelfyView && viewItem =~ /^project(?:$|:)/ && !shelfy.editMode",
          "group": "inline@3"
        },
        {
          "command": "shelfy.addProject",
          "when": "view == shelfyView && viewItem =~ /^group(?:$|:)/ && shelfy.editMode",
          "group": "inline"
        },
        {
          "command": "shelfy.addSubgroup",
          "when": "view == shelfyView && viewItem =~ /^group(?:$|:)/ && shelfy.editMode",
          "group": "inline"
        },
        {
          "command": "shelfy.renameGroup",
          "when": "view == shelfyView && viewItem =~ /^group(?:$|:)/ && shelfy.editMode",
          "group": "inline"
        },
        {
          "command": "shelfy.editItemPersonalization",
          "when": "view == shelfyView && (viewItem =~ /^group(?:$|:)/ || viewItem =~ /^project(?:$|:)/) && shelfy.editMode",
          "group": "inline"
        },
        {
          "command": "shelfy.revertItemPersonalization",
          "when": "view == shelfyView && (viewItem =~ /^group(?:$|:)/ || viewItem =~ /^project(?:$|:)/) && viewItem =~ /(^|:)hasPersonalization(:|$)/ && shelfy.editMode",
          "group": "inline"
        },
        {
          "command": "shelfy.renameProject",
          "when": "view == shelfyView && viewItem =~ /^project(?:$|:)/ && shelfy.editMode",
          "group": "inline"
        },
        {
          "command": "shelfy.addProjectScript",
          "when": "view == shelfyView && viewItem =~ /^project(?:$|:)/ && shelfy.editMode",
          "group": "inline"
        },
        {
          "command": "shelfy.cloneGroupWithNewBase",
          "when": "view == shelfyView && viewItem =~ /^group(?:$|:)/ && shelfy.editMode",
          "group": "inline"
        },
        {
          "command": "shelfy.moveItemToFolder",
          "when": "view == shelfyView && (viewItem =~ /^group(?:$|:)/ || viewItem =~ /^project(?:$|:)/) && shelfy.editMode",
          "group": "2_modification@1"
        },
        {
          "command": "shelfy.editItemPersonalization",
          "when": "view == shelfyView && (viewItem =~ /^group(?:$|:)/ || viewItem =~ /^project(?:$|:)/) && shelfy.editMode",
          "group": "2_modification@2"
        },
        {
          "command": "shelfy.addProjectScript",
          "when": "view == shelfyView && viewItem =~ /^project(?:$|:)/ && shelfy.editMode",
          "group": "2_modification@3"
        },
        {
          "command": "shelfy.renameProject",
          "when": "view == shelfyView && viewItem =~ /^project(?:$|:)/ && shelfy.editMode",
          "group": "2_modification@4"
        },
        {
          "command": "shelfy.removeItem",
          "when": "view == shelfyView && (viewItem =~ /^group(?:$|:)/ || viewItem =~ /^project(?:$|:)/) && shelfy.editMode",
          "group": "2_modification@5"
        },
        {
          "command": "shelfy.runProjectScript",
          "when": "view == shelfyView && viewItem == script && !shelfy.editMode",
          "group": "inline@1"
        },
        {
          "command": "shelfy.editProjectScript",
          "when": "view == shelfyView && viewItem == script && shelfy.editMode",
          "group": "inline"
        },
        {
          "command": "shelfy.removeProjectScript",
          "when": "view == shelfyView && viewItem == script && shelfy.editMode",
          "group": "inline"
        },
        {
          "command": "shelfy.removeItem",
          "when": "view == shelfyView && (viewItem =~ /^group(?:$|:)/ || viewItem =~ /^project(?:$|:)/) && shelfy.editMode",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "Shelfy",
      "properties": {
        "shelfy.clickAction": {
          "type": "string",
          "enum": [
            "noAction",
            "openSameInstance",
            "openNewInstance"
          ],
          "default": "openSameInstance",
          "markdownDescription": "Action for click on a project row."
        },
        "shelfy.showProjectPath": {
          "type": "boolean",
          "default": false,
          "description": "Show the folder path below the project name in the tree view."
        },
        "globalProjects.clickAction": {
          "type": "string",
          "enum": [
            "noAction",
            "openSameInstance",
            "openNewInstance"
          ],
          "default": "openSameInstance",
          "markdownDescription": "Action for click on a project row.",
          "deprecationMessage": "Deprecated. Use `shelfy.clickAction` instead."
        },
        "globalProjects.showProjectPath": {
          "type": "boolean",
          "default": false,
          "description": "Show the folder path below the project name in the tree view.",
          "deprecationMessage": "Deprecated. Use `shelfy.showProjectPath` instead."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test out/test/editModeBehavior.test.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "jsonc-parser": "^3.3.1"
  }
}
